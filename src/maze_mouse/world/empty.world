<?xml version="1.0" ?>
<!--
  空场景 world：只放地面 + 光照，用于"运动控制/能见度对比"这类不关心墙体的实验。
  用法：
    ros2 launch maze_mouse maze_bringup.launch.py \
      world:=$HOME/maze_ws/src/maze_mouse/world/empty.world
-->
<sdf version="1.6">
  <world name="empty_world">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.6 1</ambient>
      <background>0.25 0.25 0.30 1</background>
      <shadows>1</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.35 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 16 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 16 0.1</size></box></geometry>
          <material>
            <ambient>0.78 0.78 0.8 1</ambient>
            <diffuse>0.78 0.78 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 几个圆柱障碍，用来演示"反应式避障" -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.2 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.7 0.25 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>2.0 1.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.7 0.25 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 默认观察视角：从南侧斜俯视，方便看避障过程 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 -3.6 2.8 0 0.66 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
