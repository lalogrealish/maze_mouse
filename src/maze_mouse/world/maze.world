<?xml version="1.0" ?>
<!--
  迷宫仿真场景（由 gen_maze_world.py 自动生成，请勿手工修改）
  规模：5 x 5 格，格距 0.66 m（通道 0.60 m + 墙厚 0.06 m）
  外框：x ∈ [0, 3.30]，y ∈ [0, 3.30]
  入口：西墙第 0 行（y ≈ 0.33）
  出口：东墙
-->
<sdf version="1.6">
  <world name="maze_world">

    <!-- 物理引擎：步长 1 ms，保证 0.16 m/s 低速下碰撞检测稳定 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.6 1</ambient>
      <background>0.25 0.25 0.30 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- 光照：内嵌平行光，不依赖 Gazebo 在线模型库（离线也能跑） -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.35 -0.9</direction>
    </light>

    <!-- 地面：一个大盒子，上表面正好在 z = 0 -->
    <model name="ground">
      <static>true</static>
      <pose>1.6500 1.6500 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <surface>
              <friction>
                <ode>
                  <mu>1.0</mu>
                  <mu2>1.0</mu2>
                </ode>
              </friction>
              <contact>
                <ode>
                  <kp>1000000.0</kp>
                  <kd>100.0</kd>
                  <max_vel>0.01</max_vel>
                  <min_depth>0.001</min_depth>
                </ode>
              </contact>
            </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.75 0.75 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 迷宫地面色块（仅视觉，无碰撞，抬高 1 mm 避免与地面闪烁） ===== -->
    <model name="maze_floor">
      <static>true</static>
      <pose>1.6500 1.6500 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.3000 3.3000 0.002</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gazebo ROS 状态插件：提供 /gazebo/model_states 与 /get_entity_state 服务，
         用来在调试时读取机器人的"真实世界位姿"，和里程计读数做对照。
         报告里"里程计标定/误差分析"那一节就靠它。 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <!-- ===== 迷宫墙体 ===== -->
