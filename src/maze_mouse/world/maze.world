            <emissive>0.36000000000000004 0.04000000000000001 0.04000000000000001 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- 默认观察视角：从南侧斜俯视整个迷宫。这样每次启动都能一眼看全，
         录演示视频时也不用先手动拖视角。
         注意：SDF 里 <gui> 必须是 <world> 的子元素，放到 </world> 外面不生效。 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.65 -1.25 3.10 0 0.66 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
