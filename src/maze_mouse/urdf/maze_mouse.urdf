<?xml version="1.0"?>
<!--
  maze_mouse.urdf  ——  地老鼠（TurtleBot3-Burger 尺寸）差速驱动机器人模型

  【注意第一行】这里故意不写 encoding="utf-8"。
  因为 gazebo_ros 的 spawn_entity.py 会把文件读成 Python 字符串再交给 lxml 解析，
  而 lxml 不允许"Unicode 字符串 + XML 编码声明"这个组合，会直接抛
      ValueError: Unicode strings with encoding declaration are not supported
  导致 spawn 失败、Gazebo 里没有车、/scan /odom /joint_states 全都没有。
  这是本项目实际踩过的坑，改法就是删掉 encoding 属性。

  结构（自下而上）：
      base_footprint  地面投影点（机器人在地面上的"抽象位置"，不参与碰撞）
        └─ base_link  车体
             ├─ wheel_left_link   左驱动轮（连续关节，可无限旋转）
             ├─ wheel_right_link  右驱动轮
             ├─ caster_link       万向球（固定关节 + 零摩擦）
             └─ laser_link        激光雷达（固定关节）

  四个 URDF 核心标签的分工（报告第 3 章要讲）：
      <link>      刚体本体，是坐标系；本身没有形状
      <joint>     两个 link 之间的运动约束：fixed / continuous / revolute / prismatic
      <visual>    只影响 RViz 与 Gazebo 里"看起来像什么"，不影响物理
      <collision> 只影响物理碰撞，"长什么样"不参与计算（一般比 visual 简单）
      <inertial>  只影响 Gazebo 动力学（质量、质心、转动惯量），RViz 完全不用

  依赖 Gazebo 的两个插件：
      libgazebo_ros_diff_drive.so            差速驱动：收 /cmd_vel，发 /odom 与 TF
      libgazebo_ros_joint_state_publisher.so 发布轮子 joint_states（供 robot_state_publisher）
-->
<robot name="maze_mouse">

  <!-- ===================== 1. 地面投影基准点 ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- 抬高一个轮子半径：让轮子最低点正好落在 z=0 的地面上 -->
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 2. 车体 ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.105" length="0.053"/>
      </geometry>
      <material name="burger_grey">
        <color rgba="0.72 0.73 0.75 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.105" length="0.053"/>
      </geometry>
    </collision>

    <inertial>
      <!-- 实心圆柱：Ixx=Iyy=m(3r^2+h^2)/12, Izz=m*r^2/2 -->
      <!-- 质心故意后移 2 cm：车的支撑三角形是"两轮轴线 + 后方万向球"，
           质心若正好落在轮轴上（x=0），投影在三角形边界上，车头会压下去
           直到车体前缘触地（实测俯仰 18.5°，雷达前向读数从 0.96 掉到 0.50）。
           移到 x=-0.02 后就落进三角形内部，车能平稳地三点着地。 -->
      <origin xyz="-0.02 0 0.028" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.002691" ixy="0.0" ixz="0.0"
               iyy="0.002691" iyz="0.0" izz="0.004961"/>
    </inertial>
  </link>

  <!-- ===================== 3. 左驱动轮 ===================== -->
  <link name="wheel_left_link">
    <visual>
      <!-- 圆柱默认轴向是 z，绕 x 转 90° 后轴向变成 y，正好当轮轴 -->
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000150" ixy="0.0" ixz="0.0"
               iyy="0.0000272" iyz="0.0" izz="0.0000150"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <!-- y = +0.080 = 轮距 0.160 的一半，y 轴正向为机器人左侧 -->
    <origin xyz="0.0 0.080 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- effort/velocity 必须写，否则 Gazebo 里轮子转不动 -->
    <limit effort="20.0" velocity="10.0"/>
    <dynamics damping="0.10" friction="0.0"/>
  </joint>

  <!-- ===================== 4. 右驱动轮 ===================== -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000150" ixy="0.0" ixz="0.0"
               iyy="0.0000272" iyz="0.0" izz="0.0000150"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="10.0"/>
    <dynamics damping="0.10" friction="0.0"/>
  </joint>

  <!-- ===================== 5. 万向球（防倾倒） ===================== -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.010"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.010"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0000004" ixy="0.0" ixz="0.0"
               iyy="0.0000004" iyz="0.0" izz="0.0000004"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <!-- 球心落到 -0.023：0.033 - 0.023 = 0.010，正好半径贴地 -->
    <origin xyz="-0.060 0 -0.023" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 6. 激光雷达 ===================== -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.040"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000145" ixy="0.0" ixz="0.0"
               iyy="0.0000145" iyz="0.0" izz="0.0000156"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- 扫描平面高度 ≈ 0.033 + 0.135 + 0.005 = 0.173 m，与 Burger 实测一致 -->
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 7. Gazebo 物理属性 ===================== -->
  <!-- 轮子：mu 要大才能"抓住"地面产生前进力；kp/kd 是接触刚度与阻尼。
       注意 kd 必须与地面 world 里的 <kd> 保持一致（都取 100），
       否则两侧阻尼不匹配会让接触求解器产生一个很小的持续推力，
       车什么都不做也会以 mm/s 的速度自己爬 —— 实测踩过的坑。 -->
  <gazebo reference="wheel_left_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <!-- 万向球：摩擦置零，否则会拖拽车体、让实际转角远小于理论值 -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="laser_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ===================== 8. 差速驱动插件 ===================== -->
  <gazebo>
    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- 运动学参数：必须与 URDF 里的几何尺寸一致，否则里程计会系统性偏大/偏小 -->
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <!-- 0 = 编码器积分（里程计从出生点 0,0 开始）；1 或 world = 直接用世界位姿。
           本项目必须用 0：分格算法假定"odom 原点 = 出生格中心"，
           用世界位姿的话 odom.x 会直接等于世界坐标，格心全部错位。 -->
      <odometry_source>0</odometry_source>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- 轮子 TF 交给 robot_state_publisher 发，这里必须关掉，否则 TF 重复告警 -->
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- ===================== 9. 轮子关节状态发布 ===================== -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================== 10. 激光雷达传感器 ===================== -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="lds_lfcd_sensor">
      <pose>0 0 0.005 0 0 0</pose>
      <!-- 在 Gazebo 里画出扫描射线，录视频讲解"雷达看到什么"时非常直观 -->
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.50</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
